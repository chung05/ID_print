<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>身分證線上方正列印工具</title>
    <style>
        /* --- 網頁預覽樣式 --- */
        body { font-family: sans-serif; background: #f5f5f5; padding: 20px; text-align: center; }
        .controls { margin-bottom: 20px; no-print }
        .btn { padding: 10px 20px; font-size: 16px; cursor: pointer; background: #007bff; color: white; border: none; border-radius: 4px; margin: 0 5px; }
        .btn:hover { background: #0056b3; }
        
        /* 畫布容器（模擬 A4 紙張比例，方便預覽） */
        #print-area {
            background: white;
            width: 210mm;
            min-height: 140mm; /* 預覽用高度 */
            margin: 0 auto;
            padding: 20mm;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            display: flex;
            gap: 15mm;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
        }

        /* 橫排與豎排控制 */
        .layout-horizontal { flex-direction: row; }
        .layout-vertical { flex-direction: column; }

        /* 上傳框與身分證尺寸 (官方標準比例：85.7mm x 54mm) */
        .card-box {
            width: 85.7mm;
            height: 54mm;
            border: 2px dashed #ccc;
            border-radius: 4px;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
            background: #fafafa;
            cursor: pointer;
        }
        .card-box img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* 填滿並保持比例 */
        }
        .card-box input[type="file"] { display: none; }
        .placeholder { color: #888; font-size: 14px; }

        /* --- 🖨️ 列印專用樣式 --- */
        @media print {
            body { background: white; padding: 0; }
            .no-print { display: none !important; } /* 隱藏控制按鈕 */
            #print-area {
                box-shadow: none;
                margin: 0;
                padding: 0;
                width: auto;
                height: auto;
            }
            /* 確保列印時尺寸絕對精準 */
            .card-box {
                width: 85.7mm !important;
                height: 54mm !important;
                border: none !important; /* 列印時不印出虛線框 */
            }
        }
    </style>
</head>
<body>

    <div class="controls no-print">
        <h2>身分證列印工具（純前端、保障隱私）</h2>
        <button class="btn" onclick="changeLayout('horizontal')">橫排 (左右)</button>
        <button class="btn" onclick="changeLayout('vertical')">豎排 (上下)</button>
        <button class="btn" style="background:#28a745;" onclick="window.print()">🖨️ 開始列印</button>
    </div>

    <div id="print-area" class="layout-horizontal">
        
        <label class="card-box" id="box-front">
            <span class="placeholder">點選上傳【正面】照片</span>
            <input type="file" accept="image/*" onchange="handleUpload(this, 'front')">
        </label>

        <label class="card-box" id="box-back">
            <span class="placeholder">點選上傳【反面】照片</span>
            <input type="file" accept="image/*" onchange="handleUpload(this, 'back')">
        </label>

    </div>

    <script>
        // 處理圖片上傳與預覽
        function handleUpload(input, type) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const box = document.getElementById(`box-${type}`);
                    // 清空原本的文字，放入 img 標籤
                    box.innerHTML = `<img src="${e.target.result}" alt="${type}">`;
                }
                reader.readAsDataURL(file);
            }
        }

        // 切換直式或橫式排版
        function changeLayout(direction) {
            const area = document.getElementById('print-area');
            if (direction === 'horizontal') {
                area.className = 'layout-horizontal';
            } else {
                area.className = 'layout-vertical';
            }
        }
    </script>
</body>
</html>
